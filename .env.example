# Required
XPRA_PORT=14500
XPRA_BIND_HOST=127.0.0.1
XPRA_DISPLAY=:99
XPRA_HTML=on
XPRA_SOCKET_DIR=./runtime/xpra
BROWSER_PROFILE_DIR=./runtime/chromium-profile
BROWSER_CONTROL_SOCKET=./runtime/shared-browser.sock

# Optional; defaults shown
SCREEN_WIDTH=1280
SCREEN_HEIGHT=900
SCREEN_DEPTH=24
PAGE_LOAD_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000
