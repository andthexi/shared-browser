# Required for remote/VNC mode; ignored in local mode
VNC_PORT=5900
DISPLAY=:99
BROWSER_PROFILE_DIR=./runtime/chromium-profile
BROWSER_CONTROL_SOCKET=./runtime/shared-browser.sock
LOG_FILE=./runtime/shared-browser.log
PID_FILE=./runtime/shared-browser.pid

# Optional; defaults shown
SCREEN_WIDTH=1680
SCREEN_HEIGHT=945
SCREEN_DEPTH=24
PAGE_LOAD_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000
