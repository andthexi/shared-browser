{
  "name": "@andthexi/shared-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Playwright Chromium instance with localhost-only native VNC",
  "type": "module",
  "bin": {
    "shared-browser": "bin/shared-browser.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "start": "node dist/cli.js start",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "link:local": "npm run build && npm link"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
